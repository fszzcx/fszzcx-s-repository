	//两种赋值方式：
	//1.直接赋值一个内存地址
	//2.赋值变量的地址
	int var = 10;
	int* ptr2 = &var;//定义ptr2并赋值，指向var的地址
	//用ptr_address存储ptr2的地址
	int** ptr_address = &ptr2;
	std::cout << "var的地址为" << &var << std::endl;
	std::cout << "ptr2储存的地址为" << ptr2 << std::endl;
	std::cout << "ptr2的地址为" << &ptr2 << std::endl;
	std::cout << "ptr_address储存的地址为" << &ptr_address << std::endl;

	//利用指针访问对象
	int a = 10;
	int* ptr_a = &a;
	std::cout << *ptr_a << std::endl;//"*"为解引用操作符
	*ptr_a = 20;//可利用指针修改变量的值
	std::cout << "a的值为" << a << std::endl;

	//符号的多重含义
	int x = 42;
	int& r = x;//这里的&是一个引用，紧跟着类型名出现
	int* p;
	p = &r;//&出现在表达式中是一个取地址操作符
	//同理，*紧跟着类型名出现是一个指针，出现在表达式则是一个解引用操作符

	//空指针：空指针包括几种定义方式
	int* ptr1 = nullptr;
	int* ptr5 = 0;//需要使用#include<cstdlib>
	int* ptr3 = NULL;//等价于上面那种
	//错误操作 int zero = 0;
